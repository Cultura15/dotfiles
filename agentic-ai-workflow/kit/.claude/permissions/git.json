{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git shortlog *)",
      "Bash(git reflog)",
      "Bash(git reflog *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git check-ignore *)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch -v*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -r*)",
      "Bash(git branch --contains *)",
      "Bash(git remote -v)",
      "Bash(git stash list)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git pull)",
      "Bash(git pull *)",
      "Bash(git add *)",
      "Bash(git rm --cached *)",
      "Bash(git restore --staged *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git revert *)",
      "Bash(git reset --soft *)",
      "Bash(git reset --mixed *)",
      "Bash(git reset HEAD~*)",
      "Bash(git reset HEAD^*)",
      "Bash(git tag)",
      "Bash(git tag *)",
      "Bash(bash .claude/scripts/fingerprint.sh)"
    ],
    "ask": [
      "Bash(git commit --amend*)",
      "Bash(git commit * --amend*)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git stash *)",
      "Bash(git restore *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git branch -m *)",
      "Bash(git branch -M *)",
      "Bash(git tag -d *)",
      "Bash(git push * --delete *)",
      "Bash(git push * :*)",
      "Bash(git reset --keep *)",
      "Bash(git reset --merge *)"
    ],
    "deny": [
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "Read(.env)",
      "Read(.env.*)",
      "Bash(git clean*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push --mirror*)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git add -f*)",
      "Bash(git add --force*)",
      "Bash(git add * -f*)",
      "Bash(git add * --force*)",
      "Bash(git add dist*)",
      "Bash(git add * dist*)",
      "Bash(git add .env*)",
      "Bash(git add * .env*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n *)",
      "Bash(git config *)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git update-ref *)",
      "Bash(git gc*)",
      "Bash(git prune*)",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(sed -i *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)"
    ]
  }
}

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash",
      "PowerShell",
      "WebFetch",
      "WebSearch",
      "Edit(docs/reports/*/test.md)",
      "Write(docs/reports/*/test.md)",
      "mcp__Claude_Browser",
      "mcp__claude-in-chrome",
      "Bash(mkdir -p docs/reports/*)",
      "Bash(bash .claude/scripts/fingerprint.sh)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(src/**)",
      "Edit(app/**)",
      "Edit(lib/**)",
      "Edit(public/**)",
      "Edit(scripts/**)",
      "Edit(tests/**)",
      "Edit(test/**)",
      "Edit(dist/**)",
      "Edit(build/**)",
      "Edit(node_modules/**)",
      "Edit(PLAN.md)",
      "Edit(CLAUDE.md)",
      "Edit(README.md)",
      "Edit(package.json)",
      "Edit(package-lock.json)",
      "Edit(pnpm-lock.yaml)",
      "Edit(yarn.lock)",
      "Edit(tsconfig*.json)",
      "Edit(vite.config.*)",
      "Edit(vitest.config.*)",
      "Edit(eslint.config.*)",
      "Edit(next.config.*)",
      "Edit(index.html)",
      "Edit(pyproject.toml)",
      "Edit(Cargo.toml)",
      "Edit(go.mod)",
      "Edit(Makefile)",
      "Edit(.gitignore)",
      "Edit(.claude/**)",
      "Edit(docs/*.md)",
      "Edit(docs/reports/*/build.md)",
      "Edit(docs/reports/*/review.md)",
      "Edit(docs/reports/_template/**)",
      "Edit(docs/reports/README.md)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npm audit fix*)",
      "Bash(pnpm add *)",
      "Bash(yarn add *)",
      "Bash(pip install *)",
      "Bash(npx eslint --fix*)",
      "Bash(npx eslint * --fix*)",
      "Bash(npm run lint -- --fix*)",
      "Bash(npm run test:watch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git stash *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git clean *)",
      "Bash(git rm *)",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(sed -i *)"
    ]
  }
}

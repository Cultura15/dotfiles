{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "MultiEdit",
      "NotebookEdit",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Bash",
      "PowerShell",
      "WebFetch",
      "WebSearch",
      "mcp__Claude_Browser",
      "mcp__claude-in-chrome"
    ],
    "ask": [
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm ci*)",
      "Bash(npm uninstall *)",
      "Bash(npm update*)",
      "Bash(pnpm add *)",
      "Bash(pnpm install*)",
      "Bash(pnpm remove *)",
      "Bash(yarn add *)",
      "Bash(yarn remove *)",
      "Bash(pip install *)",
      "Bash(pip uninstall *)",
      "Bash(uv add *)",
      "Bash(poetry add *)",
      "Bash(cargo add *)",
      "Bash(go get *)",
      "Bash(wget *)",
      "Bash(curl -o *)",
      "Bash(curl -O *)",
      "Bash(curl * -o *)",
      "Bash(curl * -O *)",
      "Bash(curl * --output *)",
      "Bash(git clone *)",
      "Bash(rm -r *)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git reset *)",
      "Bash(git revert *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git tag *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git commit --amend*)",
      "PowerShell(npm install*)",
      "PowerShell(npm i *)",
      "PowerShell(npm uninstall *)",
      "PowerShell(pip install *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(iwr *)",
      "PowerShell(Remove-Item * -Recurse*)",
      "PowerShell(git push*)",
      "PowerShell(git pull*)",
      "PowerShell(git reset *)",
      "PowerShell(git rebase *)",
      "PowerShell(git merge *)",
      "PowerShell(git checkout *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(dist/**)",
      "Edit(node_modules/**)",
      "Edit(package-lock.json)",
      "Edit(pnpm-lock.yaml)",
      "Edit(yarn.lock)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git clean *)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git add -f *)",
      "Bash(git commit --no-verify*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git clean *)",
      "PowerShell(git reset --hard*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-on-save.cjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
